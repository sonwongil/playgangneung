# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PLAY강릉 프론트엔드 환경변수 (Vite 빌드 시 번들에 포함)
# artifacts/playgangneung-dashboard/.env 로 복사 후 값 입력
#
# 주의: VITE_ 접두사 변수는 클라이언트 번들에 노출됩니다.
#       비밀 키(시크릿)는 절대 VITE_ 접두사로 설정하지 마세요.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Clerk 인증 (공개 키 — 노출 OK) ───────────────────────
# Clerk 대시보드에서 발급 (pk_live_ 로 시작)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# Clerk Frontend API 프록시 URL
# Replit:  자동 설정됨 (설정 불필요)
# VPS:     https://playgangneung.com/api/__clerk
VITE_CLERK_PROXY_URL=https://playgangneung.com/api/__clerk

# ── 토스페이먼츠 클라이언트 키 (공개 키 — 노출 OK) ───────
# 토스페이먼츠 대시보드 → API 키 → 클라이언트 키
# 미입력 시 테스트 클라이언트 키로 동작
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxx
