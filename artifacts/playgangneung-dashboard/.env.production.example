# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 프론트엔드 Vite 빌드용 환경변수 — 운영(production) 전용
#
# 사용법:
#   cp artifacts/playgangneung-dashboard/.env.production.example \
#      artifacts/playgangneung-dashboard/.env.production
#   nano artifacts/playgangneung-dashboard/.env.production  # 실제 값으로 교체
#
# 주의:
#   - VITE_로 시작하는 변수는 빌드 시 JS 번들에 포함됩니다 (클라이언트에 노출)
#   - 시크릿 키·서버 토큰은 절대 VITE_ 변수로 넣지 마세요
#   - 이 파일은 vps-deploy.sh 실행 전에 준비되어 있어야 합니다
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Clerk 공개 키 (pk_live_... 형식, 클라이언트에 노출되는 공개 키)
# 독립 Clerk 앱(clerk.com) Production 환경의 Publishable Key
# ⚠️  디코딩 결과가 .clerk.accounts.dev 이어야 함 (clerk.playgangneung.com 이면 잘못된 키)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Clerk 프록시 URL — 독립 Clerk 사용 시 빈 값으로 설정
VITE_CLERK_PROXY_URL=

# 토스페이먼츠 클라이언트 키 (live_ck_... 형식, 클라이언트 공개 키)
VITE_TOSS_CLIENT_KEY=live_ck_REPLACE_ME

# 결제 기능 활성화 여부 (true / false)
VITE_ENABLE_TOSS_PAYMENT=false
