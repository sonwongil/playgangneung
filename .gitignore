# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# 환경변수 파일 (절대 커밋 금지)
.env
.env.local
.env.*.local
artifacts/**/.env
artifacts/**/.env.local

# PM2 로그
logs/
*.log

# ── 런타임 생성 데이터 (git clean/reclone 삭제 방지) ─────
# 디렉토리 구조는 .gitkeep으로 보존, 실제 데이터 파일은 제외
artifacts/api-server/data/*.json
artifacts/api-server/data/sessions/
artifacts/api-server/public/cards/*.png
artifacts/api-server/public/cards/*.jpg
artifacts/api-server/public/uploads/*
!artifacts/api-server/data/.gitkeep
!artifacts/api-server/public/cards/.gitkeep
!artifacts/api-server/public/uploads/.gitkeep
